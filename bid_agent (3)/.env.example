# =============================================================
# Bid News Agent — Environment Variables (secrets)
# =============================================================
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
#
# On GitHub Actions, DON'T use a .env file — instead add these
# values as repository secrets (Settings → Secrets and variables
# → Actions → New repository secret).
#
# NEVER commit .env to git. The .gitignore file already excludes it.
# =============================================================

# Telegram bot token from @BotFather (format: 123456:ABC-DEF...)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your personal Telegram chat ID (the bot must message THIS chat).
# To find it: send any message to your bot, then visit
#   https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
# and read the `chat.id` field from the JSON response.
TELEGRAM_CHAT_ID=your_chat_id_here

# --- 2merkato site login (for authenticated scraping) ---------
# The agent performs an automated Laravel form login (recaptcha
# is disabled on 2merkato, so this works). The session cookie
# unlocks bid dates and sources that are otherwise hidden behind
# "Subscription required".
SITE_LOGIN_EMAIL=your_2merkato_email_or_phone
SITE_LOGIN_PASSWORD=your_2merkato_password_here

# --- Groq AI (FREE tier — recommended LLM backend) -------------
# Groq is MUCH more generous than Gemini's free tier:
#   - 1000 requests/day (vs Gemini's ~250)
#   - 30 requests/minute (vs Gemini's ~5)
#   - ~1 second per call (vs Gemini's 3-5s)
#
# Get your free key at: https://console.groq.com/keys
#   - Sign in with any Google or GitHub account
#   - Click "Create API Key"
#   - Copy the value (starts with "gsk_...")
#
# This is the RECOMMENDED backend. The agent uses Groq first if
# GROQ_API_KEY is set, falls back to Gemini if not.
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the Groq model name (defaults to llama-3.3-70b-versatile).
# Other free options: llama-3.1-8b-instant (faster, lower quality),
#                      llama3-70b-8192, llama3-8b-8192
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Gemini AI (FREE tier — fallback if Groq not configured) ----
# Used only if GROQ_API_KEY is NOT set. Gemini 3.8 Flash free
# tier has very tight rate limits — you'll likely hit 429 errors
# during demand spikes. Strongly prefer Groq above.
#
# Get your free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model name.
# GEMINI_MODEL=gemini-3.8-flash

# --- HTTP settings ---------------------------------------------
# Optional: a custom HTTP User-Agent for scraping (some sites block
# the default `python-requests/x.x` agent).
USER_AGENT=Mozilla/5.0 (compatible; BidNewsAgent/1.0)

# Optional: HTTP proxy for scraping (leave blank if unused).
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
