# =============================================================
# Bid News Agent — Environment Variables (secrets)
# =============================================================
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
#
# NEVER commit .env to git. The .gitignore file already excludes it.
# =============================================================

# Telegram bot token from @BotFather (format: 123456:ABC-DEF...)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your personal Telegram chat ID (the bot must message THIS chat).
# To find it: send any message to your bot, then visit
#   https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
# and read the `chat.id` field from the JSON response.
TELEGRAM_CHAT_ID=your_chat_id_here

# --- 2merkato site login (for authenticated scraping) ---------
# The agent performs an automated Laravel form login (recaptcha
# is disabled on 2merkato, so this works). The session cookie
# unlocks bid dates and sources that are otherwise hidden behind
# "Subscription required".
SITE_LOGIN_EMAIL=your_2merkato_email_or_phone
SITE_LOGIN_PASSWORD=your_2merkato_password_here

# --- Gemini AI (FREE tier, 1,500 req/day) ---------------------
# When this is set, the agent uses Google Gemini 3.8 Flash
# (no cost, 1,500 requests/day) instead of the z-ai CLI.
#
# Get your free key at: https://aistudio.google.com/apikey
#   - Sign in with any Google account
#   - Click "Create API key"
#   - Copy the value (starts with "AIza...")
#
# NOTE: Gemini's free tier is geo-restricted. If your VPS region
# is blocked, you'll see "User location is not supported". Pick
# a Google-friendly region for your VPS (Phoenix, Frankfurt,
# London, etc.). Oracle Cloud Always Free supports these.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model name if Google deprecates
# the default. Examples: gemini-3.8-flash, gemini-2.5-flash
# GEMINI_MODEL=gemini-3.8-flash

# --- HTTP settings ---------------------------------------------
# Optional: a custom HTTP User-Agent for scraping (some sites block
# the default `python-requests/x.x` agent).
USER_AGENT=Mozilla/5.0 (compatible; BidNewsAgent/1.0)

# Optional: HTTP proxy for scraping (leave blank if unused).
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
